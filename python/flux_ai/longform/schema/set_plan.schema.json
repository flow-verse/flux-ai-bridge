{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flow-verse/flux-ai-bridge/longform/set_plan.schema.json",
  "title": "Flux long-form set plan",
  "description": "Set -> section -> bar plan for long-form generation. Written by the planner or by an agent, then executed by `flux-ai longform --plan`. Unknown keys are allowed so agents can annotate.",
  "type": "object",
  "required": ["schema_version", "kind", "genre", "seed", "sample_rate", "sections"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "flux.longform.set_plan"},
    "title": {"type": "string"},
    "genre": {"type": "string", "description": "Default genre table (genres/*.yaml) for sections that do not set one."},
    "seed": {"type": "integer", "minimum": 0},
    "hours": {"type": "number", "exclusiveMinimum": 0},
    "sample_rate": {"enum": [44100, 48000]},
    "target": {
      "type": "object",
      "properties": {
        "lufs": {"type": "number", "maximum": 0},
        "lufs_tolerance": {"type": "number", "minimum": 0},
        "true_peak_dbtp": {"type": "number", "maximum": 0}
      }
    },
    "energy_curve": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "points": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "minItems": 2, "maxItems": 2}}
      }
    },
    "motifs": {
      "type": "array",
      "description": "Set-level motif library; sections reference motifs by id and transform them.",
      "items": {
        "type": "object",
        "required": ["id", "bars", "notes"],
        "properties": {
          "id": {"type": "string"},
          "bars": {"type": "integer", "minimum": 1, "maximum": 8},
          "notes": {
            "type": "array",
            "description": "[start_step, length_steps, scale_degree, velocity] in sixteenth-note steps from the motif start.",
            "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}, {"type": "integer"}, {"type": "number", "minimum": 0, "maximum": 1}], "minItems": 4, "maxItems": 4}
          }
        }
      }
    },
    "anti_repetition": {
      "type": "object",
      "properties": {
        "no_repeat": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "description": "Window (in segments) inside which a pattern choice may not recur."}
      }
    },
    "human_decisions": {"type": "array", "items": {"type": "object"}, "description": "Log of human approvals/edits; copied into provenance.json."},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "key": {
      "type": "object",
      "required": ["tonic", "mode"],
      "properties": {
        "tonic": {"type": "string", "pattern": "^[A-G](#|b)?$"},
        "mode": {"type": "string", "description": "Western mode (major, minor, dorian, ...) or a maqam name defined in the genre table."}
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "segment", "type", "bpm", "key", "energy", "bars", "seeds", "transition_out"],
      "properties": {
        "id": {"type": "string"},
        "segment": {"type": "integer", "minimum": 0, "description": "Sections of one segment share key, tempo and material (a 'track' in DJ terms)."},
        "type": {"type": "string", "description": "intro | groove | build | peak | breakdown | outro, or any type the genre table defines."},
        "genre": {"type": "string"},
        "bpm": {"type": "number", "minimum": 30, "maximum": 240},
        "key": {"$ref": "#/$defs/key"},
        "camelot": {"type": ["string", "null"]},
        "energy": {"type": "number", "minimum": 0, "maximum": 1},
        "energy_end": {"type": "number", "minimum": 0, "maximum": 1},
        "bars": {"type": "integer", "minimum": 1, "maximum": 1024},
        "layers": {"type": "array", "items": {"enum": ["kick", "clap", "hat_closed", "hat_open", "perc", "ride", "bass", "chords", "pad", "lead"]}, "uniqueItems": true},
        "seeds": {
          "type": "object",
          "required": ["section"],
          "properties": {"section": {"type": "integer", "minimum": 0}},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "patterns": {
          "type": "object",
          "properties": {
            "drums": {"type": "string"},
            "bass": {"type": "string"},
            "progression": {"type": "string"},
            "chord_rhythm": {"type": "string"},
            "form": {"type": "string"}
          }
        },
        "motif": {
          "type": ["object", "null"],
          "properties": {"id": {"type": "string"}, "transform": {"type": "string"}}
        },
        "transition_out": {
          "type": "object",
          "description": "How this section hands over to the next one.",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["continue", "blend", "fade"]},
            "bars": {"type": "integer", "minimum": 0, "maximum": 64},
            "eq": {"type": "boolean"},
            "bass_swap": {"type": "boolean"}
          }
        },
        "neural": {
          "type": ["object", "null"],
          "description": "Optional neural audio layer mixed under the symbolic layers.",
          "properties": {
            "backend": {"type": "string"},
            "prompt": {"type": "string"},
            "gain_db": {"type": "number", "maximum": 0},
            "mode": {"type": "string"},
            "seed": {"type": "integer", "minimum": 0}
          },
          "required": ["backend"]
        },
        "bar_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chord": {"type": "integer", "description": "Scale degree (0-based) of the chord root."},
              "energy": {"type": "number", "minimum": 0, "maximum": 1},
              "phrase": {"type": "integer", "minimum": 0},
              "variation": {"type": "integer", "minimum": 0},
              "fill": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
